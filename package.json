{
  "name": "little-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "benchmark": "node tools/benchmark-world.mjs",
    "compile:map": "node --experimental-strip-types tools/compile-map.mjs",
    "assets:squirrel": "node --experimental-strip-types tools/generate-squirrel.mjs",
    "assets:hamster": "node --experimental-strip-types tools/generate-hamster.mjs",
    "test:studio": "node tools/test-studio-browser.mjs",
    "compile:project": "node --experimental-strip-types tools/compile-project.mjs",
    "generate:beta": "node --experimental-strip-types tools/generate-beta.mjs",
    "generate:island": "node --experimental-strip-types tools/generate-island.mjs",
    "generate:reference": "node --experimental-strip-types tools/generate-reference.mjs",
    "benchmark:route": "node tools/benchmark-route.mjs",
    "test:gameplay": "node tools/test-gameplay-browser.mjs",
    "test:ui": "node tools/test-ui-browser.mjs",
    "test:environment": "node tools/test-environment-browser.mjs",
    "test:local": "node tools/test-local-browser.mjs",
    "test:characters": "node tools/test-characters-browser.mjs",
    "generate:audio": "node --experimental-strip-types tools/generate-audio.mjs",
    "test:audio": "node tools/test-audio-browser.mjs",
    "test:water": "node tools/test-water-browser.mjs",
    "test:island": "node tools/test-island-browser.mjs",
    "test:geomap": "node tools/test-geomap-browser.mjs",
    "test:selection": "node tools/test-selection-browser.mjs",
    "test:paths": "node tools/test-paths-browser.mjs",
    "test:geo-edit": "node tools/test-geo-edit-browser.mjs",
    "test:editor": "node tools/test-editor-browser.mjs",
    "test:editor-content": "node tools/test-editor-content-browser.mjs",
    "test:editor-world": "node tools/test-editor-world-browser.mjs",
    "test:lights": "node tools/test-lights-browser.mjs",
    "bench:lights": "node --expose-gc tools/bench-lights.mjs",
    "bench:lights:browser": "node tools/bench-lights-browser.mjs",
    "generate:b1": "node --experimental-strip-types tools/generate-b1-demo.mjs",
    "test:b1": "node tools/test-b1-browser.mjs",
    "test:b1-studio": "node tools/test-b1-studio-browser.mjs",
    "bench:physics": "node tools/bench-physics.mjs",
    "bench:activities": "node --expose-gc tools/bench-activities.mjs",
    "synth:audio": "node --experimental-strip-types tools/audio-synth/build.mjs --all && node --experimental-strip-types tools/audio-synth/build-music.mjs && npm run generate:audio && node --experimental-strip-types tools/audio-synth/report.mjs",
    "check:audio-synth": "node --experimental-strip-types tools/audio-synth/build.mjs --all --check && node --experimental-strip-types tools/audio-synth/build-music.mjs --check",
    "test:audio-production": "node tests/audio-production.browser.mjs",
    "generate:world-assets": "node --experimental-strip-types tools/build-world-assets.mjs",
    "check:world-assets": "node --experimental-strip-types tools/build-world-assets.mjs --check",
    "test:landscapes": "node tools/test-landscapes-browser.mjs",
    "test:economy": "node tools/test-economy-browser.mjs",
    "test:climb": "node tools/test-climb-browser.mjs",
    "test:hamster": "node tools/test-hamster-browser.mjs",
    "capture:views": "node tools/capture-world-views.mjs",
    "generate:production-reference": "node --experimental-strip-types tools/generate-production-reference.mjs",
    "generate:world-kit": "node tools/assets/generate-world-kit.mjs && npm run generate:world-assets"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/three": "^0.180.0",
    "playwright": "1.65.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
