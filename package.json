{
  "name": "little-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && node tools/stage-archipelago.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "benchmark": "node tools/benchmark-world.mjs",
    "compile:map": "node --experimental-strip-types tools/compile-map.mjs",
    "assets:squirrel": "node --experimental-strip-types tools/generate-squirrel.mjs",
    "assets:hamster": "node --experimental-strip-types tools/generate-hamster.mjs",
    "test:studio": "node tools/test-studio-browser.mjs",
    "compile:project": "node --experimental-strip-types tools/compile-project.mjs",
    "generate:beta": "node --experimental-strip-types tools/generate-beta.mjs",
    "generate:island": "node --experimental-strip-types tools/generate-island.mjs",
    "generate:reference": "node --experimental-strip-types tools/generate-reference.mjs",
    "benchmark:route": "node tools/benchmark-route.mjs",
    "test:gameplay": "node tools/test-gameplay-browser.mjs",
    "test:ui": "node tools/test-ui-browser.mjs",
    "test:environment": "node tools/test-environment-browser.mjs",
    "test:local": "node tools/test-local-browser.mjs",
    "test:characters": "node tools/test-characters-browser.mjs",
    "generate:audio": "node --experimental-strip-types tools/generate-audio.mjs",
    "test:audio": "node tools/test-audio-browser.mjs",
    "test:water": "node tools/test-water-browser.mjs",
    "test:island": "node tools/test-island-browser.mjs",
    "test:geomap": "node tools/test-geomap-browser.mjs",
    "test:selection": "node tools/test-selection-browser.mjs",
    "test:paths": "node tools/test-paths-browser.mjs",
    "test:geo-edit": "node tools/test-geo-edit-browser.mjs",
    "test:editor": "node tools/test-editor-browser.mjs",
    "test:editor-content": "node tools/test-editor-content-browser.mjs",
    "test:editor-world": "node tools/test-editor-world-browser.mjs",
    "test:inspector-edit": "node tools/test-inspector-edit-browser.mjs && node tests/inspector-editing.browser.mjs",
    "test:lights": "node tools/test-lights-browser.mjs",
    "bench:lights": "node --expose-gc tools/bench-lights.mjs",
    "bench:lights:browser": "node tools/bench-lights-browser.mjs",
    "generate:b1": "node --experimental-strip-types tools/generate-b1-demo.mjs",
    "test:b1": "node tools/test-b1-browser.mjs",
    "test:b1-studio": "node tools/test-b1-studio-browser.mjs",
    "bench:physics": "node tools/bench-physics.mjs",
    "bench:activities": "node --expose-gc tools/bench-activities.mjs",
    "synth:audio": "node --experimental-strip-types tools/audio-synth/build.mjs --all && node --experimental-strip-types tools/audio-synth/build-music.mjs && npm run generate:audio && node --experimental-strip-types tools/audio-synth/report.mjs",
    "check:audio-synth": "node --experimental-strip-types tools/audio-synth/build.mjs --all --check && node --experimental-strip-types tools/audio-synth/build-music.mjs --check",
    "test:audio-production": "node tests/audio-production.browser.mjs",
    "generate:world-assets": "node --experimental-strip-types tools/build-world-assets.mjs",
    "check:world-assets": "node --experimental-strip-types tools/build-world-assets.mjs --check",
    "test:landscapes": "node tools/test-landscapes-browser.mjs",
    "test:economy": "node tools/test-economy-browser.mjs",
    "test:climb": "node tools/test-climb-browser.mjs",
    "test:hamster": "node tools/test-hamster-browser.mjs",
    "test:dressing-stability": "node tools/test-dressing-stability-browser.mjs",
    "test:boats": "node tools/test-boats-browser.mjs",
    "test:ferry": "node tools/test-ferry-browser.mjs",
    "test:swim": "node tools/test-swim-browser.mjs",
    "capture:views": "node tools/capture-world-views.mjs",
    "generate:production-reference": "node --experimental-strip-types tools/generate-production-reference.mjs",
    "generate:impostors": "node tools/generate-impostors.mjs",
    "check:impostors": "node tools/generate-impostors.mjs --check",
    "generate:motion": "node --experimental-strip-types tools/generate-motion-reference.mjs",
    "test:motion": "node tools/test-motion-browser.mjs",
    "generate:cliffs": "node --experimental-strip-types tools/generate-cliff-reference.mjs",
    "test:cliffs": "node tools/test-cliffs-browser.mjs",
    "capture:cliffs": "CLEAN_CAPTURE=1 node tools/capture-world-views.mjs http://127.0.0.1:5173/little-world/ /tmp/little-world-cliffs tools/cliff-views.json",
    "generate:world-kit": "node tools/assets/generate-world-kit.mjs && npm run generate:world-assets",
    "benchmark:hybrid": "node tools/benchmark-hybrid.mjs",
    "test:hybrid": "node tools/test-hybrid-browser.mjs",
    "test:impostor-optimization": "node tools/test-impostor-optimization.mjs",
    "test:hybrid-map": "node tools/test-hybrid-map.mjs",
    "benchmark:hybrid-island": "HYBRID_VIEWS=tools/island-hybrid-views.json HYBRID_CONFIGS=off,sectors HYBRID_RENDER_TIER=1 HYBRID_WAIT_IDLE=1 node tools/benchmark-hybrid.mjs",
    "test:render-budget": "node tools/test-render-budget.mjs",
    "benchmark:ground-cover": "node tools/benchmark-ground-cover.mjs",
    "test:ground-cover": "node tools/test-ground-cover.mjs",
    "test:composition": "node --experimental-strip-types tools/test-world-composition-browser.mjs",
    "test:composition-draft": "node tools/test-composition-draft-browser.mjs",
    "test:composed-islands": "node tools/test-composed-islands-browser.mjs",
    "benchmark:composed-islands": "node --experimental-strip-types tools/benchmark-composed-islands.mjs",
    "benchmark:composition": "node --experimental-strip-types tools/benchmark-world-composition.mjs",
    "benchmark:styles": "node --experimental-strip-types tools/benchmark-island-styles.mjs",
    "test:settlements": "node --experimental-strip-types tools/test-settlements-browser.mjs",
    "benchmark:settlements": "node --experimental-strip-types tools/benchmark-settlements.mjs",
    "test:settlement-services": "node --experimental-strip-types tools/test-settlement-services-browser.mjs",
    "benchmark:settlement-services": "node --experimental-strip-types tools/benchmark-settlement-services.mjs",
    "test:organic-settlements": "node --experimental-strip-types tools/test-organic-settlements-browser.mjs",
    "benchmark:organic-settlements": "node --experimental-strip-types tools/benchmark-organic-settlements.mjs",
    "test:contextual-settlements": "node --experimental-strip-types tools/test-contextual-settlements-browser.mjs",
    "test:river-town": "node --experimental-strip-types tools/test-river-town-browser.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/three": "^0.180.0",
    "playwright": "1.65.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
